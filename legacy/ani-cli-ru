#!/bin/sh

VERSION="1.1.0"

# Defaults (overridable with environment variables)
LANGUAGE="${ANI_CLI_LANG:-ru}"
QUALITY="${ANI_CLI_QUALITY:-best}"
STREAM_TYPE="${ANI_CLI_STREAM_TYPE:-dub}"
PLAYER="${ANI_CLI_PLAYER:-}"
MENU_BACKEND="${ANI_CLI_EXTERNAL_MENU:-fzf}"
DOWNLOAD_DIR="${ANI_CLI_DOWNLOAD_DIR:-$PWD}"
HIST_DIR="${ANI_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ani-cli-ru}"
LOG_ENABLED="${ANI_CLI_LOG:-1}"
API_BASE="${ANI_CLI_API_BASE:-https://api.anilibria.app/api/v1}"
API_MODE="${ANI_CLI_API_MODE:-auto}"
USER_AGENT="ani-cli-ru/${VERSION}"

DOWNLOAD_MODE=0
SHOW_LOG=0
DELETE_LOG=0
PLAYER_FORCED=0
SUBTITLE_FALLBACK_WARNED=0
EPISODE_ARG=""
RANGE_ARG=""
QUERY=""

lower() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

trim() {
    printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

has_cmd() {
    command -v "$1" >/dev/null 2>&1
}

msg() {
    key="$1"
    case "$LANGUAGE" in
        ru)
            case "$key" in
                error) printf 'Ошибка' ;;
                warning) printf 'Предупреждение' ;;
                no_results) printf 'Ничего не найдено' ;;
                select_title) printf 'Выберите аниме' ;;
                select_episode) printf 'Выберите эпизод' ;;
                prompt_query) printf 'Поиск аниме: ' ;;
                playing) printf 'Проигрывание' ;;
                downloading) printf 'Загрузка' ;;
                history_empty) printf 'История пуста' ;;
                history_deleted) printf 'История очищена' ;;
                history_header) printf 'История просмотра' ;;
                invalid_quality) printf 'Недопустимое качество. Используйте: best, worst, 360p, 480p, 720p, 1080p' ;;
                invalid_lang) printf 'Недопустимый язык. Используйте: ru или en' ;;
                invalid_range) printf 'Недопустимый диапазон эпизодов. Используйте формат N-M' ;;
                invalid_episode) printf 'Недопустимый номер эпизода' ;;
                episode_unavailable) printf 'Эпизод недоступен' ;;
                need_menu) printf 'Для интерактивного выбора нужен fzf или rofi' ;;
                need_player) printf 'Не найден поддерживаемый плеер (mpv, vlc, iina)' ;;
                need_downloader) printf 'Для загрузки нужен aria2c или wget' ;;
                need_dep) printf 'Отсутствует зависимость' ;;
                stream_missing) printf 'Не удалось получить ссылку потока для выбранного эпизода' ;;
                sub_fallback) printf 'Субтитры недоступны для этого релиза, используется обычный поток' ;;
                non_interactive_pick) printf 'Неинтерактивный режим: автоматический выбор результата' ;;
                api_failed) printf 'Ошибка запроса к AniLibria API' ;;
                api_deprecated) printf 'Текущая версия API недоступна. Укажите актуальную через ANI_CLI_API_BASE.' ;;
                unknown_option) printf 'Неизвестный параметр' ;;
                choose_query) printf 'Укажите поисковый запрос' ;;
                episode_word) printf 'Эпизод' ;;
                download_saved) printf 'Сохранено' ;;
                *) printf '%s' "$key" ;;
            esac
            ;;
        *)
            case "$key" in
                error) printf 'Error' ;;
                warning) printf 'Warning' ;;
                no_results) printf 'No results found' ;;
                select_title) printf 'Select anime' ;;
                select_episode) printf 'Select episode' ;;
                prompt_query) printf 'Search anime: ' ;;
                playing) printf 'Playing' ;;
                downloading) printf 'Downloading' ;;
                history_empty) printf 'History is empty' ;;
                history_deleted) printf 'History cleared' ;;
                history_header) printf 'Watch history' ;;
                invalid_quality) printf 'Invalid quality. Use: best, worst, 360p, 480p, 720p, 1080p' ;;
                invalid_lang) printf 'Invalid language. Use: ru or en' ;;
                invalid_range) printf 'Invalid episode range. Use N-M' ;;
                invalid_episode) printf 'Invalid episode number' ;;
                episode_unavailable) printf 'Episode is not available' ;;
                need_menu) printf 'Interactive selection requires fzf or rofi' ;;
                need_player) printf 'No supported player found (mpv, vlc, iina)' ;;
                need_downloader) printf 'Download mode requires aria2c or wget' ;;
                need_dep) printf 'Missing dependency' ;;
                stream_missing) printf 'Failed to resolve a stream URL for selected episode' ;;
                sub_fallback) printf 'Subtitles stream is unavailable for this title, using default stream' ;;
                non_interactive_pick) printf 'Non-interactive session: auto-selecting a result' ;;
                api_failed) printf 'AniLibria API request failed' ;;
                api_deprecated) printf 'Configured API version is unavailable. Set ANI_CLI_API_BASE to a working endpoint.' ;;
                unknown_option) printf 'Unknown option' ;;
                choose_query) printf 'Provide a search query' ;;
                episode_word) printf 'Episode' ;;
                download_saved) printf 'Saved' ;;
                *) printf '%s' "$key" ;;
            esac
            ;;
    esac
}

die() {
    printf '%s: %s\n' "$(msg error)" "$*" >&2
    exit 1
}

warn() {
    printf '%s: %s\n' "$(msg warning)" "$*" >&2
}

